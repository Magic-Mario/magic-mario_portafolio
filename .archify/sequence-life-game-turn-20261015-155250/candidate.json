  "cards": [
    {
      "dot": "cyan",
      "title": "One Event at a Time",
      "items": [
        "A period opens with a batch: one MAIN, one DAILY and one RELATIONSHIPS event",
        "The backend presents the first event and keeps the rest in reserve[] so ids are never repeated",
        "Advancing again while an event is pending is a 409: the period must be resolved first"
      ]
    },
    {
      "dot": "emerald",
      "title": "Never Blocked",
      "items": [
        "If the events service times out, the advance continues with a generic event",
        "The fallback is a bundled seed catalog with origin = SEED, never cached, so the real search stays open",
        "The backend revalidates country and conditions because it is the source of truth for state"
      ]
    },
    {
      "dot": "violet",
      "title": "State Lives Outside the Process",
      "items": [
        "One STATE row holds the running life; one EVENT#<seq> row is written per resolved period",
        "Zero-padded sequence keys keep the rows in chronological order",
        "When the life ends, the summary is regrouped from that history - it answers 409 while the life is still running"
      ]
    }
  ]
