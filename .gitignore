# Build output
dist/
.astro/

# Test output
test-results/
playwright-report/

# Python bytecode (Spec Kit tooling)
__pycache__/
*.pyc

# Dependencies
node_modules/

# Environment
.env
.env.*
!.env.example

# Logs & OS noise
*.log
.DS_Store
Thumbs.db

# Archify runs: keep the spec, not the generated artefacts.
# The JSON receipts embed absolute local paths, the review captures are
# throwaway screenshots, and each rendered HTML is ~750 KB of embedded fonts
# and generated SVG; none of them belongs in a public repository.
.archify/*/*.html
.archify/*/*.finalize.json
.archify/*/*.finalize-summary.json
.archify/*/*.delivery.json
.archify/*/*.browser-check.json
.archify/*/review/
.archify/*/*.review-*/
