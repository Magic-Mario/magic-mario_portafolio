---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { DEVELOPER } from '../consts';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const stack = [
  ['infrastructure', 'terraform · aws · eks · dynamodb'],
  ['services', 'python · fastapi · grpc · protobuf'],
  ['interface', 'next.js · react · typescript'],
  ['tooling', 'rust · git · sha-256'],
];
---

<BaseLayout>
  <section class="hero container">
    <div class="hero__intro">
      <p class="eyebrow">Portfolio · {new Date().getFullYear()}</p>
      <h1 class="hero__title reveal">{DEVELOPER.headline}</h1>
      <p class="lead hero__lead reveal reveal--2">
        I am {DEVELOPER.name}, a solo developer. Below are the two projects I can show in full — a
        cloud-native life simulator and the developer tooling I use to keep systems reproducible.
      </p>
      <div class="hero__actions reveal reveal--3">
        <a class="button" href="#work">Browse the work</a>
        <a class="button button--ghost" href={url('/about/')}>About me</a>
      </div>
    </div>

    <dl class="hero__panel reveal reveal--2" aria-label="What I build">
      <p class="hero__panel-title" aria-hidden="true">$ stack --summary</p>
      {
        stack.map(([label, value]) => (
          <div class="hero__row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="work-heading" class="section__title">Selected work</h2>
        <p class="section__note">
          {projects.length} case studies · each one explains the problem, the architecture, and the
          decisions behind it.
        </p>
      </div>

      <div class="project-list">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero__title {
    font-size: var(--step-4);
    max-width: 20ch;
    margin-top: var(--space-lg);
  }

  .hero__lead {
    margin-top: var(--space-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .hero__panel {
    align-self: start;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .hero__panel-title {
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .hero__row {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-sm);
    padding-block: 0.35rem;
    border-top: 1px solid var(--line);
  }

  .hero__row dt {
    color: var(--ink-3);
  }

  .hero__row dd {
    margin: 0;
    color: var(--ink-2);
  }

  .section__head {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .section__title {
    font-size: var(--step-2);
  }

  .section__note {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .project-list {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
