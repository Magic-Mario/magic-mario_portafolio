---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <section class="container container--narrow notfound">
    <p class="eyebrow">Error 404</p>
    <h1 class="notfound__title">This page does not exist.</h1>
    <p class="lead">
      The link may be broken, or the page may have been renamed. Everything the portfolio has to
      offer is one click away.
    </p>
    <div class="notfound__actions">
      <a class="button" href={url('/')}>Back to the work</a>
      <a class="text-link" href={url('/about/')}>About me</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-2xl);
  }

  .notfound__title {
    font-size: var(--step-3);
    margin-top: var(--space-md);
  }

  .notfound .lead {
    margin-top: var(--space-lg);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
</style>
