---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TechTags from '../components/TechTags.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Previous project in `order`, or undefined. */
  prev?: CollectionEntry<'projects'>;
  /** Next project in `order`, or undefined. */
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { title, summary, tech, status, year, role, repo, demo, gallery } = project.data;

const body = project.body ?? '';
const hasInlineFigures = /!\[[^\]]*\]\([^)]+\)/.test(body);
// The gallery is a safety net for projects authored without inline figures;
// when the narrative already carries its diagrams, repeating them adds noise.
const showGallery = gallery.length > 0 && !hasInlineFigures;
---

<article class="case">
  <header class="case__header">
    <div class="container container--narrow">
      <a class="case__back" href={url('/')}>
        <span aria-hidden="true">←</span> All work
      </a>

      <p class="eyebrow">
        {year && <span>{year}</span>}
        {role && <span>{role}</span>}
      </p>

      <h1 class="case__title reveal">{title}</h1>
      <p class="lead reveal reveal--2">{summary}</p>

      <div class="case__meta reveal reveal--3">
        <TechTags tech={tech} />
        <div class="case__actions">
          <StatusBadge status={status} />
          {repo && <a class="button" href={repo} rel="noopener">Source code<span aria-hidden="true"> ↗</span></a>}
          {demo && <a class="button button--ghost" href={demo} rel="noopener">Live demo<span aria-hidden="true"> ↗</span></a>}
        </div>
      </div>
    </div>
  </header>

  <div class="container container--narrow">
    <div class="prose case__prose">
      <slot />
    </div>
  </div>

  {
    showGallery && (
      <section class="case__gallery" aria-label="Project visuals">
        <div class="container">
          <h2 class="case__gallery-title">Visuals</h2>
          <div class="case__gallery-grid">
            {gallery.map((image) => (
              <Image src={image} alt={`${title} — visual`} widths={[560, 900]} sizes="(min-width: 48rem) 45vw, 100vw" loading="lazy" decoding="async" />
            ))}
          </div>
        </div>
      </section>
    )
  }
</article>

<nav class="case-nav" aria-label="Project navigation">
  <div class="container case-nav__inner">
    {
      prev ? (
        <a class="case-nav__link case-nav__link--prev" href={url(`/projects/${prev.id}/`)}>
          <span class="case-nav__label">Previous</span>
          <span class="case-nav__title">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="case-nav__link case-nav__link--next" href={url(`/projects/${next.id}/`)}>
          <span class="case-nav__label">Next</span>
          <span class="case-nav__title">{next.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </div>
</nav>

<style>
  .case__header {
    padding-block: var(--space-xl) var(--space-2xl);
    border-bottom: 1px solid var(--line);
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-3);
    text-decoration: none;
    margin-bottom: var(--space-xl);
  }

  .case__back:hover {
    color: var(--accent);
  }

  .case__header .eyebrow {
    margin-bottom: var(--space-md);
    gap: var(--space-lg);
  }

  .case__header .eyebrow span + span::before {
    content: '·';
    margin-right: var(--space-lg);
    color: var(--line-strong);
  }

  .case__title {
    font-size: var(--step-3);
    max-width: 22ch;
  }

  .case__header .lead {
    margin-top: var(--space-lg);
  }

  .case__meta {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .case__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .case__prose {
    margin-top: var(--space-2xl);
  }

  .case__gallery {
    padding-block: var(--space-2xl);
  }

  .case__gallery-title {
    font-size: var(--step-1);
    margin-bottom: var(--space-lg);
  }

  .case__gallery-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .case__gallery-grid :global(img) {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .case-nav {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding-block: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .case-nav__inner {
    display: grid;
    gap: var(--space-lg);
  }

  .case-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .case-nav__link--next {
    text-align: right;
  }

  .case-nav__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-3);
  }

  .case-nav__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--ink);
  }

  .case-nav__link:hover .case-nav__title {
    color: var(--accent);
  }

  @media (min-width: 40rem) {
    .case-nav__inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .case__gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
