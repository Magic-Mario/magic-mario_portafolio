---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TechTags from './TechTags.astro';
import StatusBadge from './StatusBadge.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, tech, cover, status, year, repo, demo } = project.data;
const href = url(`/projects/${project.id}/`);
const number = String(index + 1).padStart(2, '0');
const isFirst = index === 0;
---

<article class="card">
  <div class="card__media">
    {
      cover ? (
        <Image
          src={cover}
          alt={`${title} — project cover`}
          widths={[480, 760, 1100]}
          sizes="(min-width: 64rem) 44rem, 100vw"
          loading={isFirst ? 'eager' : 'lazy'}
          decoding={isFirst ? 'sync' : 'async'}
          fetchpriority={isFirst ? 'high' : undefined}
        />
      ) : (
        <div class="card__media-empty" aria-hidden="true">
          {number}
        </div>
      )
    }
  </div>

  <div class="card__body">
    <p class="card__meta">
      <span class="card__index">{number}</span>
      <StatusBadge status={status} />
      {year && <span class="card__year">{year}</span>}
    </p>

    <h3 class="card__title">
      <a href={href}>{title}</a>
    </h3>

    <p class="card__summary">{summary}</p>

    <TechTags tech={tech} limit={6} label={`Technologies used in ${title}`} />

    <div class="card__actions">
      <a class="arrow-link" href={href}>Read the case study</a>
      <div class="card__externals">
        {repo && <a href={repo} rel="noopener">Source<span aria-hidden="true"> ↗</span></a>}
        {demo && <a href={demo} rel="noopener">Live demo<span aria-hidden="true"> ↗</span></a>}
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .card__media {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-soft);
    aspect-ratio: 5 / 4;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.75rem;
  }

  .card__media-empty {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-serif);
    font-size: 3rem;
    color: var(--line-strong);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-3);
  }

  .card__index {
    color: var(--accent);
  }

  .card__title {
    font-size: var(--step-2);
    margin: 0;
  }

  .card__title a {
    text-decoration: none;
  }

  .card__title a:hover {
    color: var(--accent);
  }

  .card__summary {
    color: var(--ink-2);
    max-width: 46ch;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  .card__externals {
    display: flex;
    gap: var(--space-md);
  }

  .card__externals a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    text-decoration: none;
  }

  .card__externals a:hover {
    color: var(--accent);
  }

  @media (min-width: 60rem) {
    .card {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-xl);
      padding: var(--space-xl);
    }
  }
</style>
